# Maintainer: Adam 'TheElevatedOne' Mladý <admin@elevated.ovh> -> https://github.com/TheElevatedOne

pkgname=wayweather
pkgver=3.0.0
pkgrel=1
pkgdesc="Weather module for Waybar with saved locations, GPS/IP geolocation and a TUI"
arch=('x86_64' 'aarch64')
url="https://github.com/TheElevatedOne/wayweather"
license=('GPL-3.0-or-later')
depends=('curl' 'cjson' 'ncurses' 'geoclue')
makedepends=('git' 'pkgconf')
optdepends=('gpsd: GPS receiver support'
            'ttf-nerd-fonts-symbols: weather icons')
provides=('wayweather')
conflicts=('wayweather-git')
source=("git+https://github.com/TheElevatedOne/wayweather.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd wayweather
  git describe --tags --abbrev=0 | sed 's/^v//'
}

build() {
  cd wayweather
  make GEOCLUE=1 VERSION="$pkgver"
}

check() {
  cd wayweather
  make check
}

package() {
  cd wayweather
  make DESTDIR="$pkgdir" PREFIX=/usr DOCDIR=/usr/share/doc/wayweather install
}
